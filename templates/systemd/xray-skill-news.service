[Unit]
Description=Refresh public AI feeds and publish static pages
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xray-news
Group=xray-news
UMask=0077
ExecStart=/usr/bin/python3 /opt/xray-skill/src/scripts/news_site.py
TimeoutStartSec=2min
Nice=10
CPUQuota=30%
MemoryMax=256M
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/etc/xray-skill -/var/log/xray-skill -/var/lib/xray-skill
ReadWritePaths=/var/www/xray-skill /var/lib/xray-skill-news
StandardOutput=journal
StandardError=journal
