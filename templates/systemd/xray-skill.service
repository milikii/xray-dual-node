[Unit]
Description=Xray dual-node service
Wants=network-online.target
After=network-online.target

[Service]
User=xray-skill
Group=xray-skill
UMask=0077
WorkingDirectory=/opt/xray-skill/bin/xray-v26.9.30
ExecStartPre=/usr/local/bin/xray-skill-xray run -test -format json -c /etc/xray-skill/config.json
ExecStart=/usr/local/bin/xray-skill-xray run -format json -c /etc/xray-skill/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/log/xray-skill
StandardOutput=append:/var/log/xray-skill/process.log
StandardError=append:/var/log/xray-skill/process.log

[Install]
WantedBy=multi-user.target
